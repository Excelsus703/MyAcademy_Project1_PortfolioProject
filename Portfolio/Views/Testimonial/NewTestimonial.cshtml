@model Testimonial

@{
    ViewData["Title"] = "Yeni Yorum Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form class="form-control" method="post">
    <label class="form-label">Puan</label>
    <input type="text" asp-for="Rating" class="form-control" required />
    <br />
    <label class="form-label">Yorum</label>
    <input type="text" asp-for="Comment" class="form-control" required />
    <br />
    <label class="form-label">Ad</label>
    <input type="text" asp-for="FirstName" class="form-control" required />
    <br />
    <label class="form-label">Soyad</label>
    <input type="text" asp-for="LastName" class="form-control" required />
    <br />
    <label class="form-label">Baş Harfler</label>
    <input type="text" asp-for="Initials" class="form-control" required />
    <br />
    <label class="form-label">Ünvan</label>
    <input type="text" asp-for="Title" class="form-control" required />
    <br />
    <button class="btn btn-outline-primary">Kaydet</button>
</form>