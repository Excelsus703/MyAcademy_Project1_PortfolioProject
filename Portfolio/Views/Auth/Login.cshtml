@using Portfolio.Models
@model LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Portfolio Manager | Secure Login</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Hanken+Grotesk:wght@600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#ffffff",
                        "outline": "#76777d",
                        "outline-variant": "#3f465c",
                        "tertiary": "#ffffff",
                        "on-surface": "#eff1f3",
                        "on-primary-fixed-variant": "#bec6e0",
                        "on-error": "#ffffff",
                        "surface-container": "#1e293b",
                        "surface-container-low": "#131b2e",
                        "tertiary-container": "#497cff",
                        "on-tertiary-container": "#ffffff",
                        "inverse-primary": "#000000",
                        "on-background": "#eff1f3",
                        "on-primary": "#000000",
                        "on-tertiary": "#000000",
                        "on-secondary-fixed": "#eff1f3",
                        "background": "#0f172a",
                        "inverse-on-surface": "#191c1e",
                        "surface-container-highest": "#334155",
                        "surface-bright": "#1e293b",
                        "secondary-container": "#3a485c",
                        "tertiary-fixed-dim": "#b4c5ff",
                        "on-primary-fixed": "#dae2fd",
                        "surface-dim": "#0f172a",
                        "on-primary-container": "#bec6e0",
                        "inverse-surface": "#eff1f3",
                        "on-tertiary-fixed": "#00174b",
                        "primary-fixed": "#131b2e",
                        "secondary-fixed-dim": "#b9c7e0",
                        "on-surface-variant": "#94a3b8",
                        "secondary": "#94a3b8",
                        "surface-tint": "#565e74",
                        "on-secondary-fixed-variant": "#d5e3fd",
                        "surface": "#0f172a",
                        "on-secondary": "#191c1e",
                        "surface-container-high": "#1e293b",
                        "error": "#ffb4ab",
                        "on-secondary-container": "#d5e3fd",
                        "error-container": "#93000a",
                        "on-error-container": "#ffdad6",
                        "surface-variant": "#45464d",
                        "primary-container": "#ffffff",
                        "slate-auth": "#0f172a",
                        "brand-blue": "#6366f1"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.75rem",
                        "full": "1rem"
                    },
                    "spacing": {
                        "xxl": "48px",
                        "xs": "4px",
                        "gutter": "24px",
                        "sm": "8px",
                        "container-max": "1280px",
                        "md": "16px",
                        "lg": "24px",
                        "unit": "4px",
                        "xl": "32px"
                    },
                    "fontFamily": {
                        "body-sm": ["Inter"],
                        "headline-sm": ["Hanken Grotesk"],
                        "body-lg": ["Inter"],
                        "headline-lg": ["Hanken Grotesk"],
                        "label-sm": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-md": ["Hanken Grotesk"],
                        "label-md": ["Inter"]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            background: radial-gradient(circle at top left, #1e293b 0%, #0f172a 100%);
            overflow-x: hidden;
        }

        .login-card {
            box-shadow: 0px 20px 25px -5px rgba(0, 0, 0, 0.3), 0px 10px 10px -5px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(12px);
        }

        .bg-mesh {
            background-color: #0f172a;
            background-image: radial-gradient(at 0% 0%, hsla(245,100%,15%,1) 0, transparent 50%), radial-gradient(at 50% 0%, hsla(220,100%,8%,1) 0, transparent 50%), radial-gradient(at 100% 0%, hsla(260,100%,15%,1) 0, transparent 50%);
        }
    </style>
</head>
<body class="bg-mesh min-h-screen flex flex-col font-body-md text-on-surface">
    <main class="flex-grow flex items-center justify-center px-gutter py-xxl relative">
        <!-- Decorative subtle geometric background element -->
        <div class="absolute inset-0 z-0 pointer-events-none opacity-10 overflow-hidden">
            <div class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px] rounded-full border-[1px] border-brand-blue"></div>
            <div class="absolute bottom-[-5%] left-[-5%] w-[300px] h-[300px] rounded-full border-[1px] border-brand-blue"></div>
        </div>
        <!-- Login Card Container -->
        <div class="z-10 w-full max-w-[440px]">
            <div class="bg-surface-container-low/80 login-card rounded-xl border border-outline-variant p-xl flex flex-col gap-lg">
                <!-- Card Header -->
                <div class="flex flex-col items-center text-center gap-sm">
                    <div class="w-16 h-16 bg-brand-blue/10 flex items-center justify-center rounded-full mb-md ring-1 ring-brand-blue/30">
                        <span class="material-symbols-outlined text-brand-blue text-[36px]" style="font-variation-settings: 'FILL' 0;">account_circle</span>
                    </div>
                    <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">Portfolio Admin Paneli</h1>
                    <p class="font-body-sm text-body-sm text-on-surface-variant max-w-[280px]">Hoş Geldiniz. Kişisel Portfolionuzu güncellemek ve yönetmek için giriş yapınız.</p>
                </div>
                <!-- Form Section -->
                <form class="flex flex-col gap-md" method="post">
                    <!-- Email Field -->
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-md text-label-md text-on-surface flex items-center gap-xs" for="email">
                            Email veya Kullanıcı Adı
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">person</span>
                            <input class="w-full pl-[44px] pr-md py-[12px] bg-slate-900/50 border border-outline-variant rounded-lg focus:ring-[3px] focus:ring-brand-blue/20 focus:border-brand-blue outline-none transition-all font-body-md text-on-surface placeholder:text-on-surface-variant/50" id="email" placeholder="ornek@email.com" asp-for="Username" type="text" />
                            <span class="text-red-500" asp-validation-for="Username"></span>
                        </div>
                    </div>
                    <!-- Password Field -->
                    <div class="flex flex-col gap-xs">
                        <div class="flex justify-between items-center">
                            <label class="font-label-md text-label-md text-on-surface flex items-center gap-xs" for="password">
                                Şifre
                            </label>
                        </div>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">lock</span>
                            <input class="w-full pl-[44px] pr-md py-[12px] bg-slate-900/50 border border-outline-variant rounded-lg focus:ring-[3px] focus:ring-brand-blue/20 focus:border-brand-blue outline-none transition-all font-body-md text-on-surface placeholder:text-on-surface-variant/50" id="password" placeholder="••••••••" asp-for="Password" type="password" />
                            <span class="text-red-500" asp-validation-for="Password"></span>
                        </div>
                    </div>
                    <!-- Submit Button -->
                    <span class="text-red-500">@Html.ValidationSummary(excludePropertyErrors: true)</span>
                    <button class="w-full bg-brand-blue text-white font-label-md text-label-md py-[14px] rounded-lg hover:bg-brand-blue/90 active:scale-[0.98] transition-all flex items-center justify-center gap-sm shadow-lg shadow-brand-blue/20 border border-brand-blue/30" type="submit">
                        <span>Giriş Yap</span>
                        <span class="material-symbols-outlined text-[18px]">login</span>
                    </button>
                </form>
            </div>
        </div>
    </main>
    <!-- Micro-interactions Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const loginButton = document.querySelector('button[type="submit"]');
            const form = document.querySelector('form');

            loginButton.addEventListener('mousedown', () => {
                loginButton.classList.add('scale-[0.97]');
            });
            loginButton.addEventListener('mouseup', () => {
                loginButton.classList.remove('scale-[0.97]');
            });

            form.addEventListener('submit', (e) => {
                const originalContent = loginButton.innerHTML;
                loginButton.innerHTML = `
                    <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Signing in...
                `;
                setTimeout(() => {
                    loginButton.innerHTML = originalContent;
                }, 1500);
            });
        });
    </script>
</body>
</html>
