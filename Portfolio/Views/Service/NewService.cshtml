@model Service

@{
    ViewData["Title"] = "Yeni Hizmet Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form class="form-control" method="post">
    <label>İkon</label>
    <input type="text" asp-for="Icon" class="form-control" required />
    <br />
    <label>Başlık</label>
    <input type="text" asp-for="Title" class="form-control" required />
    <br />
    <label>Açıklama</label>
    <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
    <br />
    <button class="btn btn-outline-primary">Kaydet</button>
</form>