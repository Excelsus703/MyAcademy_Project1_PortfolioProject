@model List<SkillCategory>
@{
    ViewData["Title"] = "Yetenek Kategorileri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<table class="table table-hover table-bordered">
    <tr>
        <th>#</th>
        <th>Kategori Adı</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td><a href="/SkillCategory/EditCategory/@item.Id" class="btn btn-outline-info">Güncelle</a></td>
        </tr>
    }
</table>
<br />
<a href="/SkillCategory/NewCategory/" class="btn btn-outline-primary">Yeni Kategori Ekle</a>