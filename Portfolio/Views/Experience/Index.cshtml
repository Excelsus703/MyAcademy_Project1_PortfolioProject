@model List<Experience>
@{
    ViewData["Title"] = "Deneyim Bilgileri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<table class="table table-hover table-bordered">
    <tr>
        <th>Ünvan</th>
        <th>Şirket Adı</th>
        <th>Açıklama</th>
        <th>Başlangıç Yılı</th>
        <th>Bitiş Yılı</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Company</td>
            <td>@item.Description</td>
            <td>@item.StartYear</td>
            <td>@item.EndYear</td>
            <td>
                <a href="#" onclick="deleteExperience(@item.Id)" class="btn btn-outline-danger">Sil</a>
                <a href="/Experience/EditExperience/@item.Id" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>
<a href="/Experience/NewExperience/" class="btn btn-outline-primary">Yeni Deneyim Ekle</a>

<script>
    function deleteExperience(id){
            Swal.fire({
      title: "Silmek İstediğinize Emin misiniz?",
      text: "Bu İşlemi Geri Alamazsınız!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet, Sil!",
      cancelButtonText: "İptal"
    }).then((result) => {
      if (result.isConfirmed){
          window.location.href = "/Experience/DeleteExperience/" + id;
      }
    });
    }
</script>