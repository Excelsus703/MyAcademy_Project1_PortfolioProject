@model List<Skill>
@{
    ViewData["Title"] = "Yeteneklerim";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<table class="table table-hover table-bordered">
    <tr>
        <th>#</th>
        <th>Yetenek</th>
        <th>Durum</th>
        <th>Kategori</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>
                @if (item.IsActive == true)
                {
                    <span class="px-2.5 py-1 text-md-center font-semibold rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                        ● Aktif
                    </span>
                }
                else
                {
                    <span class="px-2.5 py-1 text-md-center font-semibold rounded-full bg-rose-100 text-rose-800 border border-rose-200">
                        ● Pasif
                    </span>
                }
            </td>
            <td>
                @if (item.SkillCategory.Name == "Backend")
                {
                    <span class="px-2.5 py-1 text-md-center font-medium rounded-md bg-blue-100 text-blue-700 border border-blue-200">
                        Backend
                    </span>
                }
                else if (item.SkillCategory.Name == "Frontend")
                {
                    <span class="px-2.5 py-1 text-md-center font-medium rounded-md bg-amber-100 text-amber-700 border border-amber-200">
                        Frontend
                    </span>
                }
                else
                {
                    <span class="px-2.5 py-1 text-md-center font-medium rounded-md bg-slate-300 text-slate-700 border border-slate-200">
                        @item.SkillCategory.Name
                    </span>
                }
            </td>
            <td>
                <a href="#" onclick="deleteSkill(@item.Id)" class="btn btn-outline-danger">Sil</a>
                <a href="/Skill/EditSkill/@item.Id" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>
<br />
<a href="/Skill/NewSkill/" class="btn btn-outline-primary">Yeni Yetenek Ekle</a>
<a href="/SkillCategory/Index/" class="btn btn-outline-secondary">Kategori Sayfasına Geç</a>

<script>
    function deleteSkill(id){
            Swal.fire({
      title: "Silmek İstediğinize Emin misiniz?",
      text: "Bu İşlemi Geri Alamazsınız!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet, Sil!",
      cancelButtonText: "İptal"
    }).then((result) => {
      if (result.isConfirmed){
          window.location.href = "/Skill/DeleteSkill/" + id;
      }
    });
    }
</script>