@model List<SkillCategory>

@*
    Default About Skills component
*@

<div class="grid grid-cols-2 gap-stack-md mt-stack-sm">
    @foreach (var category in Model)
    {
        <div>
            <h4 class="font-label-sm text-label-sm text-primary mb-1">@category.Name</h4>
            <p class="font-body-md text-body-md text-on-surface-variant">
                @string.Join(", ", category.Skills.Where(s => s.IsActive).Select(s => s.Name))
            </p>
        </div>
    }
</div>