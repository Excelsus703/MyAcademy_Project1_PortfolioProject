@model Education
@{
    ViewData["Title"] = "Eğitim Bilgisi Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<form class="form-control" method="post">
    <label>Okul Adı</label>
    <input type="text" asp-for="SchoolName" class="form-control" required />
    <br />
    <label>Bölüm Adı</label>
    <input type="text" asp-for="Department" class="form-control" required />
    <br />
    <label>Genel Not Ortalaması</label>
    <input type="text" asp-for="GPA" class="form-control" required />
    <br />
    <label>Başlangıç Yılı</label>
    <input type="text" asp-for="StartYear" class="form-control" required />
    <br />
    <label>Mezuniyet Yılı</label>
    <input type="text" asp-for="GraduationYear" class="form-control" />
    <br />
    <label>Açıklama</label>
    <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
    <br />
    <button class="btn btn-outline-success">Güncelle</button>
</form>