@model List<Project>
@{
    ViewData["Title"] = "Projelerim";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<table class="table table-hover table-bordered">
    <tr>
        <th>Görsel</th>
        <th>Proje Adı</th>
        <th>Proje Açıklaması</th>
        <th>Durum</th>
        <th>GitHub Linki</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td><img src="@item.ImageUrl" style="height:50px; width:50px;" /></td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            @if (item.IsDone == true)
            {
                <td class="px-lg py-4">
                    <span class="inline-flex items-center px-2 py-1 rounded-full bg-[#e6f4ea] text-[#137333] font-label-caps text-label-caps">Tamamlandı</span>
                </td>
            }
            else
            {
                <td class="px-lg py-4">
                    <span class="inline-flex items-center px-2 py-1 rounded-full bg-[#fef7e0] text-[#b06000] font-label-caps text-label-caps">Geliştiriliyor</span>
                </td>
            }
            <td><a href="@item.GitHubUrl" class="btn btn-outline-dark" target="_blank">Github Url</a></td>
            <td>
                <button class="btn btn-outline-danger" onclick="deleteProject(@item.Id)">Sil</button>
                <a href="/Project/UpdateProject/@item.Id" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>
<br />
<a href="/Project/CreateProject/" class="btn btn-outline-dark">Yeni Proje Oluştur</a>

<script>
    function deleteProject(id){
            Swal.fire({
      title: "Silmek İstediğinize Emin misiniz?",
      text: "Bu İşlemi Geri Alamazsınız!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Evet, Sil!",
      cancelButtonText: "İptal"
    }).then((result) => {
      if (result.isConfirmed){
          window.location.href = "/Project/DeleteProject/" + id;
      }
    });
    }
</script>